{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "B mark",
  "version": "0.1.2",
  "identifier": "app.bmark.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "B mark",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "theme": null,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Masoud Borodayeh",
    "publisher": "Masoud Borodayeh",
    "category": "Productivity",
    "shortDescription": "Markdown viewer with first-class Persian/RTL support",
    "longDescription": "B mark is a fast, lightweight Markdown viewer for Windows 10/11 with automatic per-block text direction detection for mixed Persian/English documents.",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdwn",
          "mdtxt"
        ],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Farsi"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "B mark"
      },
      "webviewInstallMode": {
        "type": "skip"
      },
      "allowDowngrades": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQTg3QjA4NThDRkE3QkMKUldTOHA4OVlDSHVvNmt6VEQ4MW5Ua1pZOVhLaHRKTUZpNmFqLzllU1poSEZJZjltRWNnRGtOMGgK",
      "endpoints": [
        "https://github.com/borodayeh/b-mark/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
