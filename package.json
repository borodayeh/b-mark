{
  "name": "b-mark",
  "private": true,
  "version": "0.1.2",
  "description": "B mark — a fast, modern Markdown viewer for Windows with first-class Persian/RTL support",
  "license": "MIT",
  "author": "Masoud Borodayeh",
  "homepage": "https://github.com/borodayeh/b-mark#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/borodayeh/b-mark.git"
  },
  "bugs": {
    "url": "https://github.com/borodayeh/b-mark/issues"
  },
  "keywords": [
    "markdown",
    "viewer",
    "editor",
    "persian",
    "farsi",
    "rtl",
    "tauri",
    "windows",
    "bidi",
    "vazirmatn"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "docx": "^9.8.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "9.2.1",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "^11.17.0",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^22.20.1",
    "@types/nspell": "^2.1.6",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
